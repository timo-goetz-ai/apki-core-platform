# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=REPLACE_ME_botfather_token    # ← Token von @BotFather
TELEGRAM_ALLOWED_USER_ID=REPLACE_ME_numeric_id  # ← Deine User-ID (via @userinfobot)

# ─── n8n ─────────────────────────────────────────────────────────────────────
N8N_BASE_URL=http://10.0.1.29:5678
N8N_API_KEY=REPLACE_ME                          # ← Wert aus N8N_SELF_API_KEY im n8n Container

# ─── NocoDB ──────────────────────────────────────────────────────────────────
NOCODB_BASE_URL=https://nocodb.automation-plus-ki.de
NOCODB_API_TOKEN=REPLACE_ME_nocodb_token
NOCODB_PROJECT_ID=pfx0ca6docorj8n

# ─── Prometheus ───────────────────────────────────────────────────────────────
PROMETHEUS_BASE_URL=http://10.0.1.29:9090

# ─── Coolify ──────────────────────────────────────────────────────────────────
COOLIFY_BASE_URL=https://coolify.automation-plus-ki.de
COOLIFY_API_TOKEN=REPLACE_ME_coolify_token      # ← API-Token aus Coolify Settings → API

# ─── OpenRouter (optional — AI-Fallback für unbekannte Anfragen) ──────────────
OPENROUTER_API_KEY=REPLACE_ME_openrouter_key    # ← Bereits im n8n Container vorhanden

# ─── Admin Dashboard URL (für Links in Bot-Antworten) ─────────────────────────
DASHBOARD_URL=https://aios.automation-plus-ki.de

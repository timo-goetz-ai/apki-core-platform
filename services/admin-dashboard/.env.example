# Admin-Dashboard — Beispiel-Variablen (Werte in Coolify / lokal .env.local setzen, nicht committen)

# NocoDB (Pflicht für Fabrik-Index)
NOCODB_URL=https://nocodb.example.com
NOCODB_API_TOKEN=

# Fabrik: eigene Tabelle empfohlen — siehe docs/setup/NOCODB_FABRIK_SNAPSHOTS_TABLE.md
NOCODB_FABRIK_TABLE_ID=
# NOCODB_PROJEKTE_TABLE_ID=mkbaqjiz5a2zaz4

# Dedizierte Spalten qdrant_*/embed_model/snapshot_key statt Meta nur in beschreibung
FABRIK_NOCODB_EXTENDED_COLUMNS=false

# Qdrant
QDRANT_URL=https://qdrant.example.com
QDRANT_API_KEY=
QDRANT_FABRIK_COLLECTION=aios_fabrik

# Embeddings (eines von beiden)
OPENROUTER_API_KEY=
FABRIK_EMBED_MODEL=openai/text-embedding-3-small

GOOGLE_AI_API_KEY=
# oder: GEMINI_API_KEY=

# Interne Webhooks (n8n) — siehe docs/n8n/FABRIK_WEBHOOKS.md
FABRIK_INTERNAL_WEBHOOK_TOKEN=

# Audit (optional)
# NOCODB_AUDIT_TRAIL_TABLE_ID=mgeh1epw96tgx3u

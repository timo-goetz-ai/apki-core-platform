# =============================================================================
# AIOS – Master .env.op Template
# Alle Secrets per 1Password op:// Referenz
#
# Verwendung (lokal):
#   op run --env-file=tools/op-secrets/env.op.all -- <command>
#
# In CI: wird via 1password/load-secrets-action@v2 injiziert
# In Coolify: Werte direkt in der UI als Environment Variables eintragen
#             (op:// Syntax wird von Coolify NICHT unterstützt → CI injiziert)
# =============================================================================

# ── Umgebung ─────────────────────────────────────────────────────────────────
NODE_ENV=production
ENVIRONMENT=production

# ── Docker Registry ──────────────────────────────────────────────────────────
REGISTRY=ghcr.io
OWNER=timogoetz1988

# ── Coolify ──────────────────────────────────────────────────────────────────
COOLIFY_URL=op://AIOS/Coolify/url
COOLIFY_TOKEN=op://AIOS/Coolify/token

# ── Hetzner ──────────────────────────────────────────────────────────────────
HETZNER_TOKEN=op://AIOS/Hetzner/token

# ── NocoDB ───────────────────────────────────────────────────────────────────
NOCODB_URL=op://AIOS/NocoDB/url
NOCODB_API_KEY=op://AIOS/NocoDB/api_key
NOCODB_MCP_PROJEKTE_TABLE_ID=op://AIOS/NocoDB/mcp_projekte_table_id
NOCODB_MCP_DIENSTE_TABLE_ID=op://AIOS/NocoDB/mcp_dienste_table_id
NOCODB_MCP_AUDIT_TABLE_ID=op://AIOS/NocoDB/mcp_audit_table_id
NOCODB_DB_PASSWORD=op://AIOS/NocoDB/db_password

# ── Cloudflare ───────────────────────────────────────────────────────────────
CLOUDFLARE_API_KEY=op://AIOS/Cloudflare/api_key
CLOUDFLARE_API_TOKEN=op://AIOS/Cloudflare/api_token
CLOUDFLARE_EMAIL=op://AIOS/Cloudflare/email
CLOUDFLARE_ACCOUNT_ID=op://AIOS/Cloudflare/account_id

# ── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_TOKEN=op://AIOS/GitHub/token
GITHUB_PERSONAL_ACCESS_TOKEN=op://AIOS/GitHub/token

# ── N8N ──────────────────────────────────────────────────────────────────────
N8N_BASE_URL=op://AIOS/N8N/url
N8N_WEBHOOK_URL=op://AIOS/N8N/url
N8N_API_KEY=op://AIOS/N8N/api_key
N8N_ENCRYPTION_KEY=op://AIOS/N8N/encryption_key
N8N_DB_PASSWORD=op://AIOS/N8N/db_password

# ── AI APIs ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=op://AIOS/AI-APIs/anthropic_api_key
OPENAI_API_KEY=op://AIOS/AI-APIs/openai_api_key
OPENROUTER_API_KEY=op://AIOS/AI-APIs/openrouter_api_key

# ── Core Services ─────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=op://AIOS/Core/postgres_password
DATABASE_URL=postgresql+asyncpg://aios_user:op://AIOS/Core/postgres_password@aios-db:5432/aios_db
JWT_SECRET=op://AIOS/Core/jwt_secret
DASHBOARD_API_KEY=op://AIOS/Core/dashboard_api_key

# ── Google Workspace ─────────────────────────────────────────────────────────
GOOGLE_PROJECT_ID=op://AIOS/Google-Workspace/project_id
GOOGLE_DELEGATED_USER=op://AIOS/Google-Workspace/delegated_user

# ── Agentic OS ───────────────────────────────────────────────────────────────
AGENTIC_OS_BASE_PATH=op://AIOS/AgenticOS/base_path

# ── AIOS Core (öffentliche URLs + Server→Core; Werte im 1Password-Item „Core“)
AIOS_TOKEN=op://AIOS/Core/aios_token
AIOS_CORE_URL=op://AIOS/Core/aios_core_url
NEXT_PUBLIC_AIOS_CORE_API_URL=op://AIOS/Core/next_public_aios_core_api_url
NEXT_PUBLIC_WS_URL=op://AIOS/Core/next_public_ws_url

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Admin Dashboard (aios-admin-dashboard)",
      "runtimeExecutable": "/usr/local/bin/node",
      "runtimeArgs": ["node_modules/.bin/next", "dev"],
      "cwd": "services/admin-dashboard",
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "Landing Page (automation-plus-ki.de)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "services/landing-page",
      "port": 3001
    },
    {
      "name": "Infra Dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "projects/infra-dashboard",
      "port": 3002
    },
    {
      "name": "KI-Flow Dashboard (updated)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "dashboard-experimente/ki-flow-dashboard-updated",
      "port": 3003
    }
  ]
}

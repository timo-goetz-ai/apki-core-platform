{
  "id": "iehuGVgDqOGx5hmE",
  "name": "410_PIXART_IMAGE",
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  },
  "nodes": [
    {
      "id": "wh-410",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {
        "path": "pixart-image",
        "httpMethod": "POST"
      }
    },
    {
      "id": "prep-410",
      "name": "Prompt vorbereiten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0],
      "parameters": {
        "jsCode": "const d=$input.first().json;\nconst topic=d.topic||'abstract AI technology';\nconst cat=d.category||'KI-Tools';\nconst prompt=`Professional digital artwork for blog post about ${topic}. Category: ${cat}. High quality, modern, tech aesthetic, 4K`;\nreturn [{json:{pipeline_job_id:d.pipeline_job_id||'test',prompt,topic,category:cat}}];"
      }
    },
    {
      "id": "picsart-410",
      "name": "Picsart Text2Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0],
      "parameters": {
        "method": "POST",
        "url": "https://genai-api.picsart.io/v1/text2image",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "X-Picsart-API-Key", "value": "={{ $env.PICSART_API_KEY }}"},
            {"name": "Accept", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({prompt: $json.prompt, width: 1024, height: 1024, count: 1}) }}"
      }
    },
    {
      "id": "poll-wait",
      "name": "Warte 8s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [720, 0],
      "parameters": {
        "unit": "seconds",
        "amount": 8
      }
    },
    {
      "id": "poll-status",
      "name": "Bild-Status prüfen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 0],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Picsart Text2Image').item.json.inference_id ? 'https://genai-api.picsart.io/v1/text2image/'+$('Picsart Text2Image').item.json.inference_id : 'https://genai-api.picsart.io/v1/text2image' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "X-Picsart-API-Key", "value": "={{ $env.PICSART_API_KEY }}"}
          ]
        }
      }
    },
    {
      "id": "get-url",
      "name": "Bild-URL extrahieren",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 0],
      "parameters": {
        "jsCode": "const r=$input.first().json;\nconst pj=$('Prompt vorbereiten').item.json;\nconst url=r.data?.[0]?.url||r.url||'';\nreturn [{json:{image_url:url,pipeline_job_id:pj.pipeline_job_id,source:'picsart',gdrive_folder_id:$env.GDRIVE_IMAGES_FOLDER_ID||''}}];"
      }
    },
    {
      "id": "nocodb-410",
      "name": "NocoDB media_assets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 0],
      "parameters": {
        "method": "POST",
        "url": "https://nocodb.automation-plus-ki.de/api/v2/tables/msxl4hvogh62u4u/records",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "xc-token", "value": "={{ $env.NOCODB_API_TOKEN }}"}
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({asset_id:$randomString(12),source_service:'picsart',asset_type:'image',s3_url:$json.image_url,file_name:'img-'+$json.pipeline_job_id+'.jpg',mime_type:'image/jpeg',pipeline_job_id:$json.pipeline_job_id,status:'ready',created_at:new Date().toISOString()}) }}"
      }
    },
    {
      "id": "update-pipeline-410",
      "name": "Pipeline-Job updaten",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1680, 0],
      "parameters": {
        "method": "PATCH",
        "url": "https://nocodb.automation-plus-ki.de/api/v2/tables/mgjsuwl4jwlyhdc/records",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "xc-token", "value": "={{ $env.NOCODB_API_TOKEN }}"}
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({job_id:$('Bild-URL extrahieren').item.json.pipeline_job_id,image_url:$('Bild-URL extrahieren').item.json.image_url,stage:'voice',status:'idle'}) }}"
      }
    },
    {
      "id": "resp-410",
      "name": "Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1920, 0],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {ok:true,image_url:$('Bild-URL extrahieren').item.json.image_url} }}"
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{"node": "Prompt vorbereiten", "type": "main", "index": 0}]]
    },
    "Prompt vorbereiten": {
      "main": [[{"node": "Picsart Text2Image", "type": "main", "index": 0}]]
    },
    "Picsart Text2Image": {
      "main": [[{"node": "Warte 8s", "type": "main", "index": 0}]]
    },
    "Warte 8s": {
      "main": [[{"node": "Bild-Status prüfen", "type": "main", "index": 0}]]
    },
    "Bild-Status prüfen": {
      "main": [[{"node": "Bild-URL extrahieren", "type": "main", "index": 0}]]
    },
    "Bild-URL extrahieren": {
      "main": [[{"node": "NocoDB media_assets", "type": "main", "index": 0}]]
    },
    "NocoDB media_assets": {
      "main": [[{"node": "Pipeline-Job updaten", "type": "main", "index": 0}]]
    },
    "Pipeline-Job updaten": {
      "main": [[{"node": "Response", "type": "main", "index": 0}]]
    }
  }
}

{
  "id": "u2pAiP8GaMaJQfRu",
  "name": "420_FISH_AUDIO",
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  },
  "nodes": [
    {
      "id": "wh-420",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {
        "path": "fish-audio",
        "httpMethod": "POST"
      }
    },
    {
      "id": "prep-420",
      "name": "TTS vorbereiten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0],
      "parameters": {
        "jsCode": "const d=$input.first().json;\nconst text=(d.text_content||d.text||'').slice(0,4000);\nconst voiceId=d.voice_id||$env.FISH_AUDIO_DEFAULT_VOICE||'default';\nconst jobId=d.pipeline_job_id||'test-'+Date.now();\nreturn [{json:{text,voiceId,pipeline_job_id:jobId,fileName:'voice-'+jobId+'.mp3'}}];"
      }
    },
    {
      "id": "fish-420",
      "name": "Fish Audio TTS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0],
      "parameters": {
        "method": "POST",
        "url": "https://api.fish.audio/v1/tts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "Bearer {{ $env.FISH_AUDIO_API_KEY }}"},
            {"name": "Content-Type", "value": "application/msgpack"}
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({text:$json.text,reference_id:$json.voiceId,format:'mp3',mp3_bitrate:128}) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      }
    },
    {
      "id": "fname-420",
      "name": "Dateiname",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 0],
      "parameters": {
        "jsCode": "const prep=$('TTS vorbereiten').item.json;\nreturn [{json:{fileName:prep.fileName,pipeline_job_id:prep.pipeline_job_id,binary:$input.first().binary}}];"
      }
    },
    {
      "id": "nocodb-420",
      "name": "NocoDB media_assets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 0],
      "parameters": {
        "method": "POST",
        "url": "https://nocodb.automation-plus-ki.de/api/v2/tables/msxl4hvogh62u4u/records",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "xc-token", "value": "={{ $env.NOCODB_API_TOKEN }}"}
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({asset_id:$randomString(12),source_service:'fishaudio',asset_type:'audio',s3_url:'pending',file_name:$json.fileName,mime_type:'audio/mpeg',pipeline_job_id:$json.pipeline_job_id,status:'ready',created_at:new Date().toISOString()}) }}"
      }
    },
    {
      "id": "update-pipeline-420",
      "name": "Pipeline-Job updaten",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 0],
      "parameters": {
        "method": "PATCH",
        "url": "https://nocodb.automation-plus-ki.de/api/v2/tables/mgjsuwl4jwlyhdc/records",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "xc-token", "value": "={{ $env.NOCODB_API_TOKEN }}"}
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({job_id:$('Dateiname').item.json.pipeline_job_id,stage:'publish',status:'idle'}) }}"
      }
    },
    {
      "id": "resp-420",
      "name": "Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1440, 0],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {ok:true,file:$('Dateiname').item.json.fileName} }}"
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{"node": "TTS vorbereiten", "type": "main", "index": 0}]]
    },
    "TTS vorbereiten": {
      "main": [[{"node": "Fish Audio TTS", "type": "main", "index": 0}]]
    },
    "Fish Audio TTS": {
      "main": [[{"node": "Dateiname", "type": "main", "index": 0}]]
    },
    "Dateiname": {
      "main": [[{"node": "NocoDB media_assets", "type": "main", "index": 0}]]
    },
    "NocoDB media_assets": {
      "main": [[{"node": "Pipeline-Job updaten", "type": "main", "index": 0}]]
    },
    "Pipeline-Job updaten": {
      "main": [[{"node": "Response", "type": "main", "index": 0}]]
    }
  }
}

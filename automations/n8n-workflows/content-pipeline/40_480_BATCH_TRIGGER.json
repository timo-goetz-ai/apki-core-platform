            },
            {
              "name": "topic",
              "value": "={{ $('2er-Batches').item.json.topic }}"
            },
            {
              "name": "category",
              "value": "={{ $('2er-Batches').item.json.category }}"
            }
          ]
        },
        "options": {
          "timeout": 10000,
          "redirect": {
            "redirect": {
              "followRedirects": true
            }
          }
        }
      },
      "id": "trigger-master-flow",

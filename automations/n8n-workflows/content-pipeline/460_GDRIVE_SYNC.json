{
  "name": "460_GDRIVE_SYNC",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 7 * * *" }]
        }
      },
      "id": "schedule-trigger",
      "name": "Tägl. 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "list",
        "driveId": {
          "__rl": true,
          "value": "My Drive",
          "mode": "list",
          "cachedResultName": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "value": "={{ $vars.GDRIVE_IMAGES_FOLDER_ID }}",
          "mode": "id"
        },
        "returnAll": false,
        "limit": 100,
        "options": {
          "fields": "id,name,mimeType,webViewLink,size,createdTime"
        }
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "SETUP_REQUIRED",
          "name": "Google Drive"
        }
      },
      "id": "list-images",
      "name": "GDrive: Bilder listen",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [460, 220]
    },
    {
      "parameters": {
        "operation": "list",
        "driveId": {
          "__rl": true,
          "value": "My Drive",
          "mode": "list",
          "cachedResultName": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "value": "={{ $vars.GDRIVE_AUDIO_FOLDER_ID }}",
          "mode": "id"
        },
        "returnAll": false,
        "limit": 100,
        "options": {
          "fields": "id,name,mimeType,webViewLink,size,createdTime"
        }
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "SETUP_REQUIRED",
          "name": "Google Drive"
        }
      },
      "id": "list-audio",
      "name": "GDrive: Audio listen",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [460, 420]
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "options": {}
      },
      "id": "merge-files",
      "name": "Dateien zusammenführen",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [680, 300]
    },
    {
      "parameters": {
        "batchSize": 10,
        "options": {}
      },
      "id": "split-batches",
      "name": "In Batches aufteilen",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [900, 300]
    },
    {
      "parameters": {
        "jsCode": "// Asset-Typ aus mimeType ableiten\nconst items = $input.all();\nreturn items.map(item => {\n  const f = item.json;\n  const assetType = f.mimeType?.startsWith('image/') ? 'image'\n    : f.mimeType?.startsWith('audio/') ? 'audio'\n    : 'other';\n  return { json: {\n    gdrive_file_id: f.id,\n    gdrive_url:     f.webViewLink ?? `https://drive.google.com/file/d/${f.id}/view`,\n    file_name:      f.name,\n    mime_type:      f.mimeType,\n    asset_type:     assetType,\n    source_service: 'gdrive',\n    status:         'ready',\n    created_at:     f.createdTime ?? new Date().toISOString()\n  }};\n});"
      },
      "id": "prepare-records",
      "name": "Records vorbereiten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://nocodb.automation-plus-ki.de/api/v2/tables/msxl4hvogh62u4u/records?where=(gdrive_url,eq,{{ encodeURIComponent($json.gdrive_url) }})&limit=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "xc-token", "value": "={{ $vars.NOCODB_API_TOKEN }}" }
          ]
        }
      },
      "id": "check-exists",
      "name": "NocoDB: Existiert bereits?",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false },
          "conditions": [
            {
              "id": "new-check",
              "leftValue": "={{ $json.pageInfo?.totalRows ?? $json.list?.length ?? 0 }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "equals" }
            }
          ]
        }
      },
      "id": "is-new",
      "name": "Neu?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://nocodb.automation-plus-ki.de/api/v2/tables/msxl4hvogh62u4u/records",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "xc-token", "value": "={{ $vars.NOCODB_API_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            { "name": "source_service", "value": "={{ $('Records vorbereiten').item.json.source_service }}" },
            { "name": "asset_type",     "value": "={{ $('Records vorbereiten').item.json.asset_type }}" },
            { "name": "s3_url",         "value": "={{ $('Records vorbereiten').item.json.gdrive_url }}" },
            { "name": "gdrive_url",     "value": "={{ $('Records vorbereiten').item.json.gdrive_url }}" },
            { "name": "file_name",      "value": "={{ $('Records vorbereiten').item.json.file_name }}" },
            { "name": "mime_type",      "value": "={{ $('Records vorbereiten').item.json.mime_type }}" },
            { "name": "status",         "value": "ready" },
            { "name": "created_at",     "value": "={{ $('Records vorbereiten').item.json.created_at }}" }
          ]
        }
      },
      "id": "create-asset",
      "name": "NocoDB: media_asset anlegen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://nocodb.automation-plus-ki.de/api/v2/tables/mgeh1epw96tgx3u/records",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "xc-token", "value": "={{ $vars.NOCODB_API_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            { "name": "audit_id",      "value": "={{ $now.toMillis().toString() }}-gdrive-sync" },
            { "name": "ts",            "value": "={{ $now.toISO() }}" },
            { "name": "actor",         "value": "460_GDRIVE_SYNC" },
            { "name": "action",        "value": "gdrive.sync" },
            { "name": "resource_type", "value": "media_asset" },
            { "name": "resource_id",   "value": "gdrive-batch" },
            { "name": "result",        "value": "ok" },
            { "name": "after_json",    "value": "={ \"synced_at\": \"{{ $now.toISO() }}\" }" }
          ]
        }
      },
      "id": "audit-log",
      "name": "Audit Log schreiben",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 300]
    }
  ],
  "connections": {
    "Tägl. 07:00":               { "main": [[{ "node": "GDrive: Bilder listen",     "type": "main", "index": 0 }], [{ "node": "GDrive: Audio listen", "type": "main", "index": 1 }]] },
    "GDrive: Bilder listen":     { "main": [[{ "node": "Dateien zusammenführen",    "type": "main", "index": 0 }]] },
    "GDrive: Audio listen":      { "main": [[{ "node": "Dateien zusammenführen",    "type": "main", "index": 1 }]] },
    "Dateien zusammenführen":    { "main": [[{ "node": "In Batches aufteilen",      "type": "main", "index": 0 }]] },
    "In Batches aufteilen":      { "main": [[{ "node": "Records vorbereiten",       "type": "main", "index": 0 }]] },
    "Records vorbereiten":       { "main": [[{ "node": "NocoDB: Existiert bereits?","type": "main", "index": 0 }]] },
    "NocoDB: Existiert bereits?":{ "main": [[{ "node": "Neu?",                      "type": "main", "index": 0 }]] },
    "Neu?":                      { "main": [[{ "node": "NocoDB: media_asset anlegen","type": "main", "index": 0 }], [{ "node": "Audit Log schreiben", "type": "main", "index": 0 }]] },
    "NocoDB: media_asset anlegen":{ "main": [[{ "node": "Audit Log schreiben",      "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",

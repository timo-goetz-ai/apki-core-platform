      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        480
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://nocodb.automation-plus-ki.de/api/v2/tables/m5abfrtfyr2j912/records?limit=5&sort=-created_at",
        "sendHeaders": true,
        "headerParameters": {

{
  "name": "70c_RESEARCH_DATA",
  "nodes": [
    {
      "id": "70c-trigger",
      "name": "When Called by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [250, 300],
      "parameters": {}
    },
    {
      "id": "70c-route",
      "name": "Route Research Intent",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [470, 300],
      "parameters": {
        "rules": {
          "rules": [
            {
              "outputKey": "TRENDS",
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.intent }}",
                    "rightValue": "NOCODB_TRENDS",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              }
            },
            {
              "outputKey": "SENTIMENT",
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.intent }}",
                    "rightValue": "NOCODB_SENTIMENT",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              }
            },
            {
              "outputKey": "CONTENT",
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.intent }}",
                    "rightValue": "NOCODB_CONTENT",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              }
            }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      }
    },
    {
      "id": "70c-fetch-trends",
      "name": "Fetch Trends",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 160],
      "parameters": {
        "method": "GET",
        "url": "http://homestack-nocodb:8080/api/v1/db/data/noco/pfx0ca6docorj8n/m91y1ifz2aop1ef",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "xc-token", "value": "={{ $env.NOCODB_API_TOKEN }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "limit", "value": "5" },
            { "name": "sort", "value": "-CreatedAt" }
          ]
        },
        "options": { "timeout": 8000 }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "70c-fetch-sentiment",
      "name": "Fetch Sentiment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300],
      "parameters": {
        "method": "GET",
        "url": "http://homestack-nocodb:8080/api/v1/db/data/noco/pfx0ca6docorj8n/moigzpvd4yw1d0a",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "xc-token", "value": "={{ $env.NOCODB_API_TOKEN }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "limit", "value": "5" },
            { "name": "sort", "value": "-CreatedAt" }
          ]
        },
        "options": { "timeout": 8000 }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "70c-fetch-content",
      "name": "Fetch Content Opportunities",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 440],
      "parameters": {
        "method": "GET",
        "url": "http://homestack-nocodb:8080/api/v1/db/data/noco/pfx0ca6docorj8n/m7ehbmbi5t2w0dw",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "xc-token", "value": "={{ $env.NOCODB_API_TOKEN }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "limit", "value": "5" },
            { "name": "sort", "value": "-CreatedAt" }
          ]
        },
        "options": { "timeout": 8000 }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "70c-format-trends",
      "name": "Format Trends",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, 160],
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst chatId = $('When Called by Another Workflow').first().json.chatId;\nconst rows = data?.list ?? data?.data?.list ?? [];\n\nif (rows.length === 0) {\n  return [{ json: { chatId, response: '*Trends:* Noch keine Daten vorhanden.\\n\\nWorkflows `11_TREND_MONITOR` laufen täglich um 07:00.' } }];\n}\n\nconst lines = rows.map((r, i) => {\n  const title = r.Title ?? r.title ?? r.Trend ?? r.trend ?? 'Unbekannt';\n  const score = r.Score ?? r.score ?? r.Engagement ?? '-';\n  const date = r.CreatedAt ? new Date(r.CreatedAt).toLocaleDateString('de-DE') : '';\n  return `${i + 1}. *${title}*\\nScore: ${score}  |  ${date}`;\n});\n\nreturn [{ json: {\n  chatId,\n  response: `*Aktuelle Trends* (letzte 5):\\n\\n${lines.join('\\n\\n')}`\n} }];"
      }
    },
    {
      "id": "70c-format-sentiment",
      "name": "Format Sentiment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, 300],
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst chatId = $('When Called by Another Workflow').first().json.chatId;\nconst rows = data?.list ?? data?.data?.list ?? [];\n\nif (rows.length === 0) {\n  return [{ json: { chatId, response: '*Sentiment:* Noch keine Daten vorhanden.\\n\\nWorkflow `12_SENTIMENT_TRACKER` läuft alle 4 Stunden.' } }];\n}\n\nconst emojiMap = { positive: '🟢', neutral: '🟡', negative: '🔴' };\n\nconst lines = rows.map((r, i) => {\n  const topic = r.Topic ?? r.topic ?? r.Trend ?? r.trend ?? 'Unbekannt';\n  const sentiment = (r.Sentiment ?? r.sentiment ?? 'neutral').toLowerCase();\n  const score = r.Score ?? r.score ?? '-';\n  const emoji = emojiMap[sentiment] ?? '⚪';\n  const date = r.CreatedAt ? new Date(r.CreatedAt).toLocaleDateString('de-DE') : '';\n  return `${i + 1}. ${emoji} *${topic}*\\nSentiment: ${sentiment}  |  Score: ${score}  |  ${date}`;\n});\n\nreturn [{ json: {\n  chatId,\n  response: `*Sentiment-Analyse* (letzte 5):\\n\\n${lines.join('\\n\\n')}`\n} }];"
      }
    },
    {
      "id": "70c-format-content",
      "name": "Format Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, 440],
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst chatId = $('When Called by Another Workflow').first().json.chatId;\nconst rows = data?.list ?? data?.data?.list ?? [];\n\nif (rows.length === 0) {\n  return [{ json: { chatId, response: '*Content Opportunities:* Noch keine Daten vorhanden.\\n\\nWorkflow `13_CONTENT_OPPORTUNITY` läuft täglich.' } }];\n}\n\nconst priorityEmoji = { high: '🔥', medium: '📋', low: '💡' };\n\nconst lines = rows.map((r, i) => {\n  const title = r.Title ?? r.title ?? r.Opportunity ?? 'Unbekannt';\n  const priority = (r.Priority ?? r.priority ?? 'medium').toLowerCase();\n  const emoji = priorityEmoji[priority] ?? '📋';\n  const format = r.Format ?? r.format ?? r.Type ?? '';\n  const date = r.CreatedAt ? new Date(r.CreatedAt).toLocaleDateString('de-DE') : '';\n  return `${i + 1}. ${emoji} *${title}*\\nPriorität: ${priority}${format ? '  |  ' + format : ''}  |  ${date}`;\n});\n\nreturn [{ json: {\n  chatId,\n  response: `*Content Opportunities* (letzte 5):\\n\\n${lines.join('\\n\\n')}`\n} }];"
      }
    },
    {
      "id": "70c-merge",
      "name": "Merge Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1180, 300],
      "parameters": {
        "mode": "passThrough",
        "output": "input1"
      }
    }
  ],

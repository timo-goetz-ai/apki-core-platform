      "typeVersion": 2,
      "position": [
        1920,
        660
      ],
      "parameters": {
        "jsCode": "const prev = $('Execute Deactivate').first().json;\nconst chatId = prev.chatId;\nconst name = prev.workflowName;\nconst result = $input.first().json;\n\nif (result.error) {\n  return [{ json: { chatId, response: `❌ Fehler: ${result.message ?? 'Deaktivierung fehlgeschlagen'}` } }];\n}\n\nreturn [{ json: { chatId, response: `⏸ Workflow \\`${name}\\` wurde *deaktiviert*.` } }];"
      }
    },
    {
      "id": "70a-cancel-resp",
      "name": "Cancel Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1200,
        780
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "chatId",
              "value": "={{ $json.chatId }}",
              "type": "string"
            },

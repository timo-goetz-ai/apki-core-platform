    },
    {
      "parameters": {
        "content": "## Job-Research Workflow\n\n1. Hier: Apify-Node für StepStone/Indeed einbinden\n2. Oder: HTTP Request zu Job-API\n3. Output: NocoDB Create Records in Tabelle 'jobs'\n\n**Credentials:** NocoDB API, SMTP (mail-eu.smtp2go.com:2525), Apify (optional)",
        "height": 200,
        "width": 400
      },
      "id": "placeholder-research",
      "name": "Placeholder: Job-Scraping",

          "text": "={{ '🎯 *Job-Monitor ' + new Date().toLocaleDateString('de-DE') + '* — ' + $input.all().length + ' Treffer\\n\\n' + $input.all().slice(0,6).map((j,i)=>`${i+1}\\. *${j.json.title}*\\n🏢 ${j.json.company} | 📍 ${j.json.location}\\n💰 ${j.json.salary} | ⭐ ${j.json.score}/10\\n💡 ${j.json.note}\\n🔗 ${j.json.url}`).join('\\n\\n') }}"
        }
      }

    {
      "id": "061ead8d-0d73-4c8c-ba36-10c8e0bbfe63",
      "name": "Format & Deduplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 100],
      "parameters": {
        "jsCode": "const seen=new Set(),out=[];\nfor(const item of $input.all()){\n  for(const j of (item.json.results||[])){\n    if(!seen.has(j.id)){seen.add(j.id);out.push({json:{\n      job_id:j.id,title:j.title,\n      company:j.company?.display_name||'?',\n      location:j.location?.display_name||'',\n      salary_min:j.salary_min||0,salary_max:j.salary_max||0,\n      salary:j.salary_min?Math.round(j.salary_min/1000)+'k-'+Math.round(j.salary_max/1000)+'k €':'k.A.',\n      desc:(j.description||'').slice(0,200),\n      url:j.redirect_url,created:j.created\n    }});}\n  }\n}\nreturn out.slice(0,25);"
      }
    },
    {
      "id": "4e2a4983-a979-4d6b-8577-1905bafad29f",
      "name": "Gemini: Relevanz",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 100],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "sendQuery": true,
        "queryParameters": {"parameters": [{"name": "key", "value": "={{ $env.GEMINI_API_KEY }}"}]},
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({contents:[{parts:[{text:'Bewerte Stellenangebot für KI/Automation-Manager, Bad Homburg (50km Radius), Zielgehalt 70-85k€. Job: '+$json.title+' bei '+$json.company+' in '+$json.location+', Gehalt: '+$json.salary+'. Nur JSON: {\"score\":1-10,\"match\":\"hoch|mittel|niedrig\",\"note\":\"max 15 Wörter\"}'}]}]}) }}"
      }
    },
    {
      "id": "eefd8e8b-f626-4e1c-b731-281d05983e7e",
      "name": "Filter Score >= 6",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 100],
      "parameters": {
        "jsCode": "const out=[];\nfor(const item of $input.all()){\n  try{\n    const t=item.json.candidates?.[0]?.content?.parts?.[0]?.text||'{}';\n    const r=JSON.parse(t.replace(/```json|```/g,'').trim());\n    if((r.score||0)>=6) out.push({json:{...item.json,score:r.score,match:r.match,note:r.note}});\n  }catch(e){}\n}\nreturn out;"
      }
    },
    {
      "id": "c451802a-629e-476f-b514-c8adb3fa1051",
      "name": "Telegram Digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 100],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "body": {
          "chat_id": "={{ $env.TELEGRAM_ALLOWED_USER_ID }}",
          "parse_mode": "Markdown",
          "disable_web_page_preview": true,
          "text": "={{ '🎯 *Job-Monitor ' + new Date().toLocaleDateString('de-DE') + '* — ' + $input.all().length + ' Treffer\\n\\n' + $input.all().slice(0,6).map((j,i)=>`${i+1}\\. *${j.json.title}*\\n🏢 ${j.json.company} | 📍 ${j.json.location}\\n💰 ${j.json.salary} | ⭐ ${j.json.score}/10\\n💡 ${j.json.note}\\n🔗 ${j.json.url}`).join('\\n\\n') }}"
        }
      }
    },

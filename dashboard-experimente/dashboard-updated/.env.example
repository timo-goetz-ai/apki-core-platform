# ─────────────────────────────────────────────────────────────────────────────
# KI-Flow Infra Dashboard — Environment Variables
# Copy to .env.local for local dev, inject via Coolify for production.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── n8n ───────────────────────────────────────────────────────────────────────
N8N_INTERNAL_URL=http://n8n:5678
N8N_API_KEY=your_n8n_api_key_here

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_INTERNAL_URL=http://grafana:3000
GRAFANA_SERVICE_ACCOUNT_TOKEN=your_grafana_sa_token_here

# ── NocoDB ────────────────────────────────────────────────────────────────────
NOCODB_URL=https://nocodb.automation-plus-ki.de
NOCODB_INTERNAL_URL=http://nocodb:8080
NOCODB_API_TOKEN=your_nocodb_token_here

# ── Nextcloud ─────────────────────────────────────────────────────────────────
NEXTCLOUD_URL=https://cloud.automation-plus-ki.de
NEXTCLOUD_INTERNAL_URL=http://nextcloud:80

# ── Authentik ─────────────────────────────────────────────────────────────────
AUTHENTIK_URL=https://auth.automation-plus-ki.de
AUTHENTIK_INTERNAL_URL=http://authentik-server:9000

# ── Vaultwarden ───────────────────────────────────────────────────────────────
VAULTWARDEN_URL=https://vault.automation-plus-ki.de
VAULTWARDEN_INTERNAL_URL=http://vaultwarden:80

# ── Prometheus ────────────────────────────────────────────────────────────────
PROMETHEUS_URL=https://prometheus.automation-plus-ki.de
PROMETHEUS_INTERNAL_URL=http://prometheus:9090
# Format: "user:password" — will be base64 encoded server-side
PROMETHEUS_BASIC_AUTH=

# ── Home Assistant ────────────────────────────────────────────────────────────
HA_URL=https://ha.automation-plus-ki.de
HA_INTERNAL_URL=http://homeassistant:8123
HA_LONG_LIVED_TOKEN=your_ha_long_lived_token_here

# ── MCP Hub ───────────────────────────────────────────────────────────────────
MCP_HUB_URL=https://mcp.automation-plus-ki.de
MCP_HUB_INTERNAL_URL=http://mcp-hub:8080

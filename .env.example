# =============================================================================
# AIOS – Environment Template
# Kopiere als .env und fülle alle Werte aus. NIEMALS committen!
# =============================================================================

# Umgebung
NODE_ENV=development
ENVIRONMENT=local

# Docker Registry
REGISTRY=ghcr.io
OWNER=timogoetz1988

# API-Konfiguration
API_PORT=8000
API_HOST=0.0.0.0
NEXT_PUBLIC_AIOS_CORE_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Datenbank – PostgreSQL
POSTGRES_HOST=aios-db
POSTGRES_PORT=5432
POSTGRES_DB=aios_db
POSTGRES_USER=aios_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://aios_user:change_me@aios-db:5432/aios_db

# Datenbank – MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=aios_mysql
MYSQL_USER=aios_user
MYSQL_PASSWORD=change_me

# Redis
REDIS_URL=redis://aios-redis:6379/0

# AI APIs
OPENROUTER_API_KEY=sk-or-...
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Browserless
BROWSERLESS_URL=http://aios-browserless:3000
BROWSERLESS_TOKEN=change_me

# N8N
N8N_BASE_URL=https://n8n.automation-plus-ki.de
N8N_WEBHOOK_URL=https://n8n.automation-plus-ki.de/webhook

# NocoDB
NOCODB_URL=http://nocodb:8080
NOCODB_API_KEY=change_me

# Auth
JWT_SECRET=change_me_min_32_chars
JWT_EXPIRY=24h

# Monitoring
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
LOKI_URL=http://aios-loki:3100

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Hetzner (für Deployment-Scripts)
HETZNER_IP=your.hetzner.ip
HETZNER_USER=root
SSH_KEY_PATH=~/.ssh/id_rsa

# Feature Flags
FEATURE_CREW_API=true
FEATURE_MCP_SERVERS=false

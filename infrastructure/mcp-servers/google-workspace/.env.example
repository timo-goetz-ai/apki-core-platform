# ============================================================
# Google Workspace MCP Server - Environment Configuration
# ============================================================

# --- Google Cloud Service Account ---
# Path to your service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# --- Google Workspace Domain-Wide Delegation ---
# The email of the Google Workspace user to impersonate
# Required for Drive, Calendar, Sheets, Slides, Forms access
GOOGLE_DELEGATED_USER=your-email@your-domain.com

# --- Google Cloud Project ---
GOOGLE_PROJECT_ID=your-project-id

# --- Admin Security ---
# Your Google account email (only this account can use the server)
ADMIN_EMAIL=your-email@your-domain.com

# --- OpenAI (for natural language prompt parsing) ---
OPENAI_API_KEY=sk-...

# --- Server Mode ---
# Set to "true" to log actions without executing them
DRY_RUN=false

# --- Logging ---
LOG_LEVEL=info

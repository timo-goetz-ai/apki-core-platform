# Hetzner Cloud API Token
# Get your token from https://console.hetzner.cloud/account/api-tokens
HETZNER_TOKEN=your_api_token_here

# Optional: SSH command timeout in seconds (default: 30)
SSH_TIMEOUT=30

# Optional: API request timeout in seconds (default: 30)
API_TIMEOUT=30

# Optional: Debug mode
DEBUG=false

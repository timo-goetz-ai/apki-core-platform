# KI-Bewerbungs-Automation – Umgebungsvariablen
# Kopiere zu .env und fülle die Werte aus

# =========== N8n ===========
N8N_USER=admin
N8N_PASSWORD=<starkes-passwort>
N8N_HOST=localhost
N8N_PROTOCOL=http

# =========== NocoDB ===========
NC_AUTH_JWT_SECRET=<generiere-mit-openssl-rand-hex-32>
NC_PUBLIC_URL=http://localhost:8080

# =========== Optional: Externe URLs (bei Reverse Proxy) ===========
# N8N_HOST=n8n.deine-domain.de
# N8N_PROTOCOL=https
# NC_PUBLIC_URL=https://nocodb.deine-domain.de

# =========== N8n Credentials (in N8n UI anlegen) ===========
# NocoDB API Token
# SMTP: mail-eu.smtp2go.com, Port 2525 (TLS) oder 465 (SSL)
# OpenAI/Claude, Apify (optional)

# MCP-Ops Stack - Umgebungsvariablen
# Kopiere als .env und trage echte Werte ein

# --- Coolify MCP Server ---
COOLIFY_URL=https://coolify.automation-plus-ki.de
COOLIFY_TOKEN=DEIN_COOLIFY_TOKEN
MCP_COOLIFY_API_KEY=DEIN_API_KEY

# --- Hetzner MCP Server ---
HETZNER_TOKEN=DEIN_HETZNER_TOKEN
MCP_HETZNER_API_KEY=DEIN_API_KEY

# --- Cloudflare MCP Server ---
CLOUDFLARE_API_KEY=DEIN_CLOUDFLARE_KEY
CLOUDFLARE_EMAIL=timo@automation-plus-ki.de
MCP_CLOUDFLARE_API_KEY=DEIN_API_KEY

# --- Google Workspace MCP Server ---
GOOGLE_DELEGATED_USER=timo@automation-plus-ki.de
GOOGLE_PROJECT_ID=DEIN_GOOGLE_PROJECT_ID
OPENAI_API_KEY=DEIN_OPENAI_KEY
MCP_GOOGLE_API_KEY=DEIN_API_KEY
GOOGLE_CREDENTIALS_PATH=./google-credentials

# --- GitHub MCP Server ---
GITHUB_PERSONAL_ACCESS_TOKEN=DEIN_GITHUB_PAT
MCP_GITHUB_API_KEY=DEIN_API_KEY

# Postiz Stack — Beispiel-Env-Vars (NICHT committen mit echten Werten)
# Echte Werte in Coolify unter dem Stack-Ressource setzen

POSTIZ_DB_PASS=REPLACE_WITH_SECURE_PASSWORD
POSTIZ_JWT_SECRET=REPLACE_WITH_32_CHAR_HEX_SECRET

# Hetzner S3 (shared mit NocoDB/Dashboard)
NC_S3_ACCESS_KEY=REPLACE_WITH_HETZNER_S3_KEY
NC_S3_ACCESS_SECRET=REPLACE_WITH_HETZNER_S3_SECRET

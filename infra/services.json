      "image": "n8nio/n8n:latest",
      "deployment": "homestack",
      "category": "automation",
      "status": "active",
      "port": 5678
    },
    {
      "name": "NocoDB",
      "id": "nocodb",
      "url": "https://nocodb.automation-plus-ki.de",
      "internal": "nocodb:8080",
      "image": "nocodb/nocodb:latest",

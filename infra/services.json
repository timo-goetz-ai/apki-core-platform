  "databases": [
    {
      "id": "postgres",
      "type": "PostgreSQL",
      "internal": "homestack-postgres:5432",
      "deployment": "homestack",
      "databases": ["aios_db", "n8n", "nocodb", "grafana", "authentik", "vaultwarden"]
    },
    {
      "id": "redis",
      "type": "Redis",
      "internal": "homestack-redis:6379",
      "deployment": "homestack",
      "used_by": ["n8n", "authentik", "crew-api"]
    }
  ],
  "storage": {
    "provider": "Hetzner Object Storage",
    "region": "fsn1",
    "endpoint": "https://fsn1.your-objectstorage.com",
    "buckets": [
      {"name": "noco-aios", "used_by": "nocodb"}
    ]
  }
}

{
  "platform": "automation-plus-ki",
  "updated": "2026-03-17",
  "server": {
    "provider": "Hetzner",
    "type": "CPX42",
    "ip": "<HETZNER_HOST>",
    "os": "Ubuntu 22.04 LTS",
    "cpu": "8 vCPU",
    "ram": "16 GB",
    "disk": "240 GB SSD"
  },
  "dns": {
    "provider": "Cloudflare",
    "zone": "automation-plus-ki.de",
    "pattern": "*.automation-plus-ki.de → A → <HETZNER_HOST>"
  },
  "proxy": {
    "type": "Traefik",
    "managed_by": "Coolify",
    "tls": "Let's Encrypt (ACME)",
    "config_path": "/data/coolify/proxy/dynamic/"
  },
  "services": [
    {
      "name": "Admin Dashboard",
      "id": "admin-dashboard",
      "url": "https://admin.automation-plus-ki.de",
      "internal": "homestack-admin:3000",
      "image": "ghcr.io/timogoetz1988/aios-admin-dashboard:latest",
      "deployment": "coolify",
      "coolify_id": "046279494c60465d88e337efb54d5504",
      "category": "core",
      "status": "active",
      "port": 3000,
      "source": "github:TimoGoetz1988/aios"
    },
    {
      "name": "AIOS-Core API",
      "id": "nexus-core",
      "url": "https://api.automation-plus-ki.de",
      "internal": "nexus-core:8000",
      "image": "nexus-core",
      "deployment": "homestack",
      "category": "core",
      "status": "active",
      "port": 8000,
      "source": "github:TimoGoetz1988/aios services/nexus-core"
    },
    {
      "name": "Crew API",
      "id": "crew-api",
      "url": null,
      "internal": "aios-crew-api:8001",
      "image": "aios-crew-api",
      "deployment": "homestack",
      "category": "core",
      "status": "active",
      "port": 8001,
      "source": "github:TimoGoetz1988/aios services/crew-api"
    },
    {
      "name": "n8n",
      "id": "n8n",
      "url": "https://n8n.automation-plus-ki.de",
